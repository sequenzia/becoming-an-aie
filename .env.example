# Copy to .env for local development. Never commit .env.
# Names only (NFR-6.2.4). A value that has a default is named in a comment with its default; set it on its
# own line to override. An empty value is not the same as unset: astro:env rejects an empty URL, boolean, or
# enum value, so leave a defaulted variable out instead of writing NAME= (docs/decisions.md, 2026-10-03).
#
# BUILD-TIME VALUES (astro:env public). Inlined into dist/server by `astro build`.
# Setting them in the running container has no effect; the Dockerfile takes them as build args.
# SITE_URL: public origin of the site. Drives security.allowedDomains and absolute links.
#   Default http://localhost:4321.
# FEATURE_ACCOUNTS: show sign-in and account routes. Default true. The Phase 0 image is built with false.
# PREVIEW_DRAFTS: render draft modules. Default false. Local dev and the CI e2e build only. Never in an image.

# RUNTIME VALUES (astro:env secret). Read from the environment when the server starts.
# BETTER_AUTH_URL: Better Auth base URL. Defaults to SITE_URL. Must be the public origin in production.
# EMAIL_PROVIDER: only 'none' exists (the default). Sets the no-op mailer.

# Postgres. Leave unset for the embedded PGlite database in dev.
# No ssl parameters in the URL. TLS is configured through PG_CA_FILE.
DATABASE_URL=
# Path to the RDS CA bundle. Required whenever DATABASE_URL is set in production.
# The image sets /app/certs/rds-global-bundle.pem.
PG_CA_FILE=
# PGLITE_DATA_DIR: a directory for a persistent local PGlite database, for example ./.pglite-dev.
#   Unset means in-memory (lost on restart). A production build refuses the embedded database unless this is set.

# Secrets. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
NOTIFY_TOKEN_SECRET=
# OAuth apps. Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/github and /google.
# BETTER_AUTH_URL equals SITE_URL in production, so both name the same origin.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Runtime only, set by the container. Not read by Astro.
# HOST=0.0.0.0
# PORT=8080
# BETTER_AUTH_TELEMETRY=0
