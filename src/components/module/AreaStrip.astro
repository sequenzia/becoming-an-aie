---
// src/components/module/AreaStrip.astro
// The area header of an area module page (blueprint 10.4, design-tokens section 5). It carries the
// page's h1, so a page that renders it renders no PageHeader. The strip bleeds to the edges of the
// content column (the padding box of main.container), not to the viewport: a 100vw bleed adds a
// horizontal scrollbar wherever the vertical scrollbar takes width (docs/decisions.md, 2026-10-03).
import type { MiniMapKey } from '../../lib/types';
import MiniMap from '../site/MiniMap.astro';

export interface Props {
  name: string;
  beat: string;
  minimap: MiniMapKey;
}

const { name, beat, minimap } = Astro.props;
---

<div class="area-strip">
  <div class="container">
    <div>
      <h1 class="area-strip-name">{name}</h1>
      <p class="area-strip-beat">{beat}</p>
    </div>
    <MiniMap variant={minimap} />
  </div>
</div>

<style>
  .area-strip {
    margin-inline: calc(-1 * var(--gutter));
    margin-block-end: var(--space-6);
  }
</style>
