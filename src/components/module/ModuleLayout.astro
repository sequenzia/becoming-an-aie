---
// src/components/module/ModuleLayout.astro
// The page shell for every module (blueprint sections 4.7, 8, 10.4; section 14 contract: props
// { entry } and a default slot for <Content />). The page sets locals.module, locals.learner, and
// locals.formError before rendering this layout, and the body components read them.
//
// Top to bottom: the area strip (area modules) or the page header (every other kind), a draft line
// under PREVIEW_DRAFTS, the summary, the meta facts with the learner's status chip when signed in,
// the prerequisite notice listing only unmet prerequisites, the stale notice when the module's own
// checked-on date is past its threshold, then the body. The body's sections, the self-check, and the
// completion controls come from the MDX file through the components map.
import Base from '../../layouts/Base.astro';
import PageHeader from '../site/PageHeader.astro';
import StatusChip from '../site/StatusChip.astro';
import AreaStrip from './AreaStrip.astro';
import ModuleMeta from './ModuleMeta.astro';
import PrerequisiteNotice from './PrerequisiteNotice.astro';
import StaleNotice from './StaleNotice.astro';
import { AREA_KEYS, KIND_GROUP_TITLES } from '../../lib/content-schema';
import { isStale } from '../../lib/dates';
import type { ModuleEntry } from '../../lib/modules';

export interface Props {
  entry: ModuleEntry;
}

const { entry } = Astro.props;
const data = entry.data;
const module = Astro.locals.module;
const prerequisites = module?.prerequisites ?? [];
const preview = module?.preview ?? data.draft;
const area = data.area === 'none' ? undefined : data.area;
const bodyArea = area ?? (data.kind === 'closing' ? 'transition' : undefined);
const kicker = data.kind === 'closing' ? 'Self-assessment' : data.kind === 'elective' ? 'Elective' : KIND_GROUP_TITLES[data.kind];
const stale = isStale(data.checkedOn, data.staleAfterDays);
---

<Base title={data.title} description={data.summary} area={bodyArea}>
  {area ? (
    <AreaStrip name={data.title} beat={`Module ${data.order} of ${AREA_KEYS.length}`} minimap={area} />
  ) : data.kind === 'closing' ? (
    <PageHeader kicker={kicker} area="The transition" minimap="all" title={data.title} />
  ) : (
    <PageHeader kicker={kicker} minimap="all" title={data.title} />
  )}
  {preview && (
    <p class="module-preview compact">
      <StatusChip status="draft" />{' '}
      Draft preview. This module is not published. It renders because the build enabled draft preview.
    </p>
  )}
  <div class="module-head">
    <p class="module-summary">{data.summary}</p>
    <ModuleMeta entry={entry} prerequisites={prerequisites} />
    <PrerequisiteNotice prerequisites={prerequisites} />
    {stale && <StaleNotice checkedOn={data.checkedOn} thresholdDays={data.staleAfterDays} />}
  </div>
  <div class="module-body">
    <slot />
  </div>
</Base>

<style>
  .module-preview {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-block-end: var(--space-4);
  }
  .module-head {
    max-width: var(--measure-wide);
    margin-block-end: var(--space-8);
  }
  .module-summary {
    max-width: var(--measure);
    font-size: var(--size-kicker);
    line-height: 1.4;
    margin-block-end: var(--space-4);
  }
  /* Reading measure for text, the wide measure for the diagram, cards, and tables. */
  .module-body {
    max-width: var(--measure-wide);
  }
  .module-body > :global(* + *) {
    margin-block-start: 1em;
  }
  .module-body :global(:is(p, ul, ol, dl, blockquote, h2, h3, h4)) {
    max-width: var(--measure);
  }
  .module-body :global(:is(section, blockquote, .callout-surface, .callout, .collapsible-body) > * + *) {
    margin-block-start: 1em;
  }
  .module-body :global(h2) {
    margin-block-start: var(--space-12);
  }
  .module-body :global(h2 + h3) {
    margin-block-start: var(--space-4);
  }
  .module-body :global(ul),
  .module-body :global(ol) {
    padding-inline-start: 1.25rem;
  }
  .module-body :global(blockquote) {
    border-left: 4px solid var(--color-hairline);
    padding-inline-start: var(--space-4);
    font-size: var(--size-heading);
    line-height: 1.3;
  }
  .module-body :global(table) {
    max-width: var(--measure-wide);
  }
</style>
