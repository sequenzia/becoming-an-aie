---
// src/components/site/Collapsible.astro
// details and summary with a chevron (blueprint 10.4). Native, so it works without JavaScript.
export interface Props {
  title: string;
  open?: boolean;
}

const { title, open = false } = Astro.props;
---

<details class="collapsible" open={open}>
  <summary>
    <span>{title}</span>
    <svg class="chevron" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
      <path d="M5.5 2.5 11 8l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </summary>
  <div class="collapsible-body">
    <slot />
  </div>
</details>
